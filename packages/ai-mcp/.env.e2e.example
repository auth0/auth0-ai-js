# Real-tenant e2e settings. Copy to .env.e2e (gitignored, keep it mode 600) and fill in the values.
# Names only here. Real environment variables win over this file.

# Required for every scenario
AUTH0_E2E_DOMAIN=
AUTH0_E2E_MCP_AUDIENCE=
AUTH0_E2E_DOWNSTREAM_AUDIENCE=
AUTH0_E2E_OBO_CLIENT_ID=
AUTH0_E2E_OBO_CLIENT_SECRET=
AUTH0_E2E_LOGIN_CLIENT_ID=
AUTH0_E2E_LOGIN_CLIENT_SECRET=
AUTH0_E2E_USERNAME=
AUTH0_E2E_PASSWORD=
AUTH0_E2E_REALM=

# Optional: existing scenarios
AUTH0_E2E_DOWNSTREAM_SCOPE=
AUTH0_E2E_M2M_CLIENT_ID=
AUTH0_E2E_M2M_CLIENT_SECRET=
AUTH0_E2E_ORG_ID=
# Retired in favor of the expiry scenarios, still accepted for now
AUTH0_E2E_EXPIRED_TOKEN=
# Read-only Management API access for the tenant prerequisites check: a token, or a client pair
AUTH0_E2E_MGMT_TOKEN=
AUTH0_E2E_MGMT_CLIENT_ID=
AUTH0_E2E_MGMT_CLIENT_SECRET=

# Optional: multiple downstream services
AUTH0_E2E_ORDERS_AUDIENCE=
AUTH0_E2E_INVENTORY_AUDIENCE=
AUTH0_E2E_ANALYTICS_AUDIENCE=
AUTH0_E2E_LEDGER_AUDIENCE=

# Optional: client with a limited grant
AUTH0_E2E_LIMITED_CLIENT_ID=
AUTH0_E2E_LIMITED_CLIENT_SECRET=

# Optional: organizations and authorization code login
AUTH0_E2E_ORG_A_ID=
AUTH0_E2E_ORG_B_ID=
AUTH0_E2E_ORG_USER_USERNAME=
AUTH0_E2E_ORG_USER_PASSWORD=
AUTH0_E2E_AUTHCODE_CLIENT_ID=
AUTH0_E2E_AUTHCODE_CLIENT_SECRET=
AUTH0_E2E_AUTHCODE_REDIRECT_PORT=
# Client credentials client allowed to mint tokens for organization A and B
AUTH0_E2E_ORG_TESTER_CLIENT_ID=
AUTH0_E2E_ORG_TESTER_CLIENT_SECRET=

# Optional: expiry scenarios (slow tier)
AUTH0_E2E_SHORT_MCP_AUDIENCE=
AUTH0_E2E_SHORT_DOWNSTREAM_AUDIENCE=
AUTH0_E2E_SHORT_LIFETIME_SECONDS=
AUTH0_E2E_SHORT_OBO_CLIENT_ID=
AUTH0_E2E_SHORT_OBO_CLIENT_SECRET=

# Optional: real MCP client run
AUTH0_E2E_CLAUDE_BIN=
AUTH0_E2E_T2_PORT=
# Must equal http://localhost:<AUTH0_E2E_T2_PORT>/mcp
AUTH0_E2E_T2_MCP_AUDIENCE=
AUTH0_E2E_T2_USERNAME=
AUTH0_E2E_T2_PASSWORD=
