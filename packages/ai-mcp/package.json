{
  "name": "@auth0/ai-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Auth0 token delegation and request authentication for Model Context Protocol servers",
  "repository": {
    "type": "git",
    "url": "https://github.com/auth0/auth0-ai-js",
    "directory": "packages/ai-mcp"
  },
  "homepage": "https://github.com/auth0/auth0-ai-js/tree/main/packages/ai-mcp#readme",
  "types": "dist/esm/index.d.ts",
  "main": "dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:markers",
    "build:watch": "run-p 'build:esm -- --watch' 'build:cjs -- -watch'",
    "build:esm": "tsc --project ./tsconfig.build.json --outDir ./dist/esm",
    "build:cjs": "tsc --project ./tsconfig.build.json --module nodenext --moduleResolution nodenext --outDir ./dist/cjs",
    "build:markers": "node ./scripts/write-module-markers.mjs",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "vitest run test/smoke",
    "e2e": "node scripts/e2e/run.mjs",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "files": [
    "dist/**/*.{*js,*js.map,d.ts,d.ts.map}",
    "dist/**/package.json"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./mcp-sdk": {
      "import": {
        "types": "./dist/esm/mcp-sdk.d.ts",
        "default": "./dist/esm/mcp-sdk.js"
      },
      "require": {
        "types": "./dist/cjs/mcp-sdk.d.ts",
        "default": "./dist/cjs/mcp-sdk.js"
      }
    },
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "author": {
    "name": "Auth0 Inc.",
    "url": "https://auth0.com"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@auth0/auth0-api-js": "^1.7.0",
    "jose": "^6.0.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "^2.3.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.7",
    "@eslint/js": "^9.18.0",
    "@modelcontextprotocol/client": "^2.3.0",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/server": "^2.3.0",
    "@types/node": "^22.10.6",
    "@vitest/coverage-v8": "^3.0.9",
    "eslint": "^9.22.0",
    "express": "^5.2.1",
    "globals": "^15.11.0",
    "msw": "^2.0.0",
    "typedoc": "^0.27.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.9",
    "zod": "^4.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
