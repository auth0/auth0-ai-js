# Auth0 tenant domain, without scheme.
AUTH0_DOMAIN=your-tenant.us.auth0.com

# Public URL of this server. It is also the identifier of the API that represents
# it: access tokens sent to the server must be issued for it. The server listens on the
# port in this URL and serves the route at its path.
AUTH0_AUDIENCE=http://localhost:3002/mcp

# Application that performs the token exchanges.
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret

# Scopes every request to the MCP server must carry (space separated). Optional.
MCP_REQUIRED_SCOPES=

# Identifier (audience) of the orders API.
ORDERS_AUDIENCE=https://fastmcp-orders.api/

# Base URL of the orders API process the tools call.
ORDERS_API_URL=http://localhost:3004
# Longest wait for the orders API, in milliseconds. Optional, defaults to 5000.
DOWNSTREAM_TIMEOUT_MS=5000

# Listen port of the orders API.
ORDERS_API_PORT=3004
