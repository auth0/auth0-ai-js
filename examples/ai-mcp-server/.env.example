# Auth0 tenant domain, without scheme.
AUTH0_DOMAIN=your-tenant.us.auth0.com

# Public URL of this server. It is also the identifier of the API that represents
# it: access tokens sent to the server must be issued for it.
MCP_SERVER_URL=http://localhost:3001/mcp

# Application that performs the token exchanges and the client credentials grant.
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret

# Scopes every request to the MCP server must carry (space separated). Optional.
MCP_REQUIRED_SCOPES=

# Identifiers (audiences) of the three store APIs.
ORDERS_AUDIENCE=https://orders.api/
INVENTORY_AUDIENCE=https://inventory.api/
ANALYTICS_AUDIENCE=https://analytics.api/

# Base URL of the store API process the tools call.
STORE_API_URL=http://localhost:3003
# Longest wait for the store API, in milliseconds. Optional, defaults to 5000.
DOWNSTREAM_TIMEOUT_MS=5000

# Listen ports.
MCP_PORT=3001
DOWNSTREAM_PORT=3003

# Only for "npm run smoke:real". The smoke test signs a test user in with the Resource Owner
# Password grant. That grant is for local testing only.
# Client that may use the password grant, and its secret if it is confidential.
SMOKE_LOGIN_CLIENT_ID=
SMOKE_LOGIN_CLIENT_SECRET=
# Test user credentials (the shopper from the tenant setup).
SMOKE_USERNAME=
SMOKE_PASSWORD=
# Database connection name. When set, the password-realm grant is used. Optional.
SMOKE_REALM=
# Scope requested for the user token. Optional, defaults to openid plus the three tool scopes.
SMOKE_SCOPE=
